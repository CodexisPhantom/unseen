{
  "openapi": "3.1.0",
  "info": {
    "title": "Unseen API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health check. Public.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The service works",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "x-permission": "public"
      }
    }
  },
  "components": {
    "schemas": {
      "DatabaseStatus": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ]
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "version",
          "database"
        ],
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "version": {
            "type": "string",
            "description": "Version of the running binary."
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable string. Clients switch on this."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "requiredPermission": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "URI that identifies the problem kind."
          }
        }
      }
    }
  }
}
