{
  "openapi": "3.1.0",
  "info": {
    "title": "Unseen API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health check. Public.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The service works",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "x-permission": "public"
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "The signed-in user, their roles and effective permissions. Authenticated,\nno permission.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-permission": "authenticated"
      }
    },
    "/api/v1/permissions": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "The permission catalog, in catalog order.",
        "operationId": "list_permissions",
        "responses": {
          "200": {
            "description": "Every permission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Permission"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-permission": "roles:manage"
      }
    },
    "/api/v1/roles": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Every role: the Owner role first, then by name.",
        "operationId": "list_roles",
        "responses": {
          "200": {
            "description": "The roles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Role"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-permission": "roles:manage"
      },
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Creates a role with permissions the caller holds.",
        "operationId": "create_role",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRole"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The new role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            }
          },
          "403": {
            "description": "A permission the caller lacks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The name is taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-permission": "roles:manage"
      }
    },
    "/api/v1/roles/{id}": {
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Deletes a custom role. A role that users hold needs `confirm=true`; the\nusers lose it. Refused for the Owner role, and for a role that holds a\npermission the caller lacks.",
        "operationId": "delete_role",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Role id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "confirm",
            "in": "query",
            "description": "Required when users hold the role.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "description": "The Owner role, or a permission the caller lacks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Users hold the role and `confirm` is not set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-permission": "roles:manage"
      },
      "patch": {
        "tags": [
          "users"
        ],
        "summary": "Changes a custom role. Refused for the Owner role, and for a role that\nholds a permission the caller lacks.",
        "operationId": "update_role",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Role id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RolePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The changed role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            }
          },
          "403": {
            "description": "The Owner role, or a permission the caller lacks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The name is taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-permission": "roles:manage"
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Whether the first-run setup is still required. Public.",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Setup status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        },
        "x-permission": "public"
      },
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Creates the first user with the Owner role and signs it in. Public while\nno user exists, 409 after.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The Owner exists and is signed in; the response sets the session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupUser"
                }
              }
            }
          },
          "409": {
            "description": "A user already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The library refused the name, email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "x-permission": "public"
      }
    }
  },
  "components": {
    "schemas": {
      "DatabaseStatus": {
        "type": "string",
        "enum": [
          "ok",
          "error"
        ]
      },
      "FieldError": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "version",
          "database"
        ],
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "version": {
            "type": "string",
            "description": "Version of the running binary."
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "user",
          "roles",
          "isOwner",
          "permissions"
        ],
        "properties": {
          "isOwner": {
            "type": "boolean",
            "description": "The user holds the Owner role."
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "description": "Effective permissions in catalog order: every role plus direct grants.\nAn Owner has the whole catalog."
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeRole"
            },
            "description": "Ordered by name."
          },
          "user": {
            "$ref": "#/components/schemas/MeUser"
          }
        }
      },
      "MeRole": {
        "type": "object",
        "required": [
          "id",
          "name",
          "isOwner"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "isOwner": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "MeUser": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "NewRole": {
        "type": "object",
        "required": [
          "name",
          "permissions"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      },
      "Permission": {
        "type": "string",
        "description": "One entry of the permission catalog, `resource:action`.",
        "enum": [
          "library:read",
          "library:add",
          "library:edit",
          "library:delete",
          "search:run",
          "release:grab",
          "queue:read",
          "queue:manage",
          "import:run",
          "subtitles:manage",
          "indexers:read",
          "indexers:manage",
          "clients:read",
          "clients:manage",
          "profiles:read",
          "profiles:manage",
          "settings:read",
          "settings:manage",
          "users:manage",
          "roles:manage",
          "apikeys:manage",
          "system:logs",
          "system:backup",
          "system:tasks",
          "system:audit"
        ]
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable string. Clients switch on this."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "requiredPermission": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "URI that identifies the problem kind."
          }
        }
      },
      "Role": {
        "type": "object",
        "required": [
          "id",
          "name",
          "isOwner",
          "permissions",
          "users"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "isOwner": {
            "type": "boolean",
            "description": "The built-in Owner role. Read-only; it holds the whole catalog."
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "users": {
            "type": "integer",
            "format": "int64",
            "description": "Number of users who hold the role.",
            "minimum": 0
          }
        }
      },
      "RolePatch": {
        "type": "object",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "An empty text clears the description."
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "permissions": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "description": "Replaces the whole set."
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "At least 10 characters."
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "type": "boolean",
            "description": "True until the first user exists."
          }
        }
      },
      "SetupUser": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
