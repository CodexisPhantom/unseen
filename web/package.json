{
	"name": "unseen-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"gen": "openapi-typescript ../openapi.json -o src/lib/api/schema.d.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node scripts/check-static.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.73.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/svelte-query": "^6.4.1",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^4.1.12",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.1.0",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"zod": "^4.6.7"
	}
}
