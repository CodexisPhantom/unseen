{
	"name": "unseenarr-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"gen": "openapi-typescript ../openapi.json -o src/lib/api/schema.d.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun scripts/check-static.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.79.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/svelte-query": "^6.4.7",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"better-auth": "1.7.6",
		"bits-ui": "^2.22.0",
		"cn": "^0.5.2",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"formsnap": "^2.1.0",
		"globals": "^17.14.0",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"phosphor-svelte": "^3.1.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "5.57.3",
		"svelte-check": "^4.7.8",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.6",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0"
	}
}
